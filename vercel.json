{
    "framework": null,
    "buildCommand": null,
    "outputDirectory": "frontend/dist",
    "installCommand": null,
    "devCommand": null,
    "routes": [
        {
            "src": "/api/login",
            "dest": "api/index.py"
        },
        {
            "src": "/api/health",
            "dest": "api/index.py"
        },
        {
            "src": "/api/debug",
            "dest": "api/index.py"
        },
        {
            "src": "/api/(.*)",
            "dest": "api/index.py"
        },
        {
            "src": "/(.*)",
            "dest": "frontend/dist/$1"
        }
    ]
}
